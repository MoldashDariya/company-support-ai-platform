# =============================================================================
# Company Support AI Platform — environment template
# Copy to .env for local dev. On Render, set these in the dashboard (Secrets).
# =============================================================================

# --- Required ---
TELEGRAM_BOT_TOKEN=

# OpenAI-compatible LLM (OpenAI, Cerebras, Azure OpenAI, etc.)
OPENAI_API_KEY=
# Legacy aliases also supported: LLM_API_KEY, CEREBRAS_API_KEY
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Retrieval ---
# Set ENABLE_SEMANTIC_SEARCH=false on Render free tier (BM25-only, no torch/Chroma)
ENABLE_SEMANTIC_SEARCH=true
RETRIEVAL_MODE=hybrid
ENABLE_BM25=true
RETRIEVAL_TOP_K=5
SEMANTIC_MIN_SCORE=0.20
RETRIEVAL_WEAK_THRESHOLD=0.12
RETRIEVAL_CANDIDATE_POOL=15
MAX_GROUNDED_CONTEXT_CHARS=7000
MAX_FRAGMENT_BODY_CHARS=450
HYBRID_RRF_K=60

# --- Embeddings & ChromaDB ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHROMA_COLLECTION=company_knowledge
CORPUS_LANGUAGE=ru

# --- Grounding & citations ---
CITATION_INCLUDE_URLS=true
LLM_TEMPERATURE=0.2

# --- Company branding ---
COMPANY_NAME=Центр Красок #1
COMPANY_PHONE=+77780615000
COMPANY_SITE=https://centr-krasok.kz/

# --- Conversation ---
MAX_SESSION_TURNS=8
ENABLE_STREAMING=true
MEMORY_SUMMARY_MAX_CHARS=1200

# --- Safety ---
THROTTLE_MAX_REQUESTS=12
THROTTLE_WINDOW_SEC=60

# --- Optional: website ingestion (run refresh_knowledge.py locally or as one-off job) ---
# INGESTION_SEED_URLS=https://example.com/
# CRAWL_MAX_PAGES=80
# CRAWL_MAX_HTML_BYTES=150000
# CHUNK_MAX_CHARS=500
# CHUNK_OVERLAP_CHARS=80
